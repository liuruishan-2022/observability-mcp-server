# Prometheus 配置
PROMETHEUS_ROOT=http://localhost:9090

# Loki 配置
LOKI_ROOT=http://localhost:3100

# Harbor 配置 (可选 - 用于容器镜像仓库管理)
HARBOR_URL=https://harbor.example.com
HARBOR_USERNAME=admin
HARBOR_PASSWORD=Harbor12345

# Nacos 配置 (可选 - 用于服务发现和配置管理)
NACOS_URL=http://localhost:8848
NACOS_ACCESS_TOKEN=your_access_token_here

# Kafka 配置 (可选 - 用于消息队列管理)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=mcp-kafka-consumer-group
KAFKA_USERNAME=your_kafka_username
KAFKA_PASSWORD=your_kafka_password
KAFKA_SECURITY_PROTOCOL=plaintext
